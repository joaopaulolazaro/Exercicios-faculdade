programa {
  funcao inicio() {
  cadeia produto
  real valor

  escreva("Quantos procutos você está comprando: ")
  leia(produto)

  escreva("Qual o valor total dos produtos: ")
  leia(valor)

  se(valor >  100){
       escreva("Você ganhou frete grátis!")
  }
  
  senao
       escreva("Frete não disponível. ")
 
 
  }

}
